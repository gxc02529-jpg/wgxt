# 后端环境配置模板：复制为 .env 后按需修改
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env

# ---- 运行环境与跨域 ----
# 本地开发使用 development；生产部署必须改为 production
APP_ENV=development
# 多个前端来源用英文逗号分隔；生产环境禁止使用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库连接 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=wengaofabu

# ---- JWT 安全配置（生产环境务必使用至少 32 位随机字符串）----
SECRET_KEY=change-me-to-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 文件上传 ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=20971520
BASE_URL=http://localhost:8000

# ---- Dify 工作流（预留）----
DIFY_API_BASE=
DIFY_API_KEY=
DIFY_TIMEOUT=30

# ---- AI 大模型 API ----
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
AI_TIMEOUT=60

# ---- Tavily 新闻搜索 ----
TAVILY_API_KEY=
TAVILY_TIMEOUT=15

# ---- 本地 Embedding ----
EMBEDDING_MODEL_NAME=backend/app/multilingual-e5-small
EMBEDDING_DEVICE=auto

# ---- Grounded 事件整理 LLM ----
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT=90
