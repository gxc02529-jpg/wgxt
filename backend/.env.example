# 后端环境配置模板：复制为 .env 后按需修改
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env

# ---- 数据库连接 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=wengaofabu

# ---- JWT 安全配置（生产环境务必修改为随机长字符串）----
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
# 过期时间（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 文件上传 ----
# 上传文件保存目录（相对 backend 目录或绝对路径）
UPLOAD_DIR=uploads
# 单文件最大字节数，默认 20MB
MAX_UPLOAD_SIZE=20971520
# 静态资源完整 URL 前缀，生产环境改为实际域名
BASE_URL=http://localhost:8000

# ---- Dify 工作流（预留）----
# Dify 应用 API 地址：云端 https://api.dify.ai/v1，自建为 http(s)://你的域名/v1
DIFY_API_BASE=
# Dify 应用 API Key（格式 app-xxx，在 Dify 控制台「访问 API」中获取）
DIFY_API_KEY=
# 调用超时（秒）
DIFY_TIMEOUT=30
